# Copier ce fichier sous le nom .env, à la racine du dépôt, et coller les clés après le signe =
# Pas d'espace autour du =, pas de guillemets. Le fichier .env n'est jamais poussé sur GitHub.
# Vérifier ensuite avec : python -m tools.verifier_cles
FRED_API_KEY=

# Bedrock : identifiants AWS. En session cloud, ce sont les variables de l'environnement cloud
# (rien à copier ici) ; aucun secret réseau ne doit viser bedrock-runtime, il remplacerait la signature.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
AWS_DEFAULT_REGION=us-east-1
# Facultatif : modèle Bedrock (défaut de Strands sinon).
BEDROCK_MODEL_ID=

# Sources ajoutées (branche donnees-api). En session cloud, Finnhub et CoinGecko peuvent passer par
# un secret réseau : la variable reste alors vide et le proxy ajoute la clé lui-même.
SEC_USER_AGENT=
FINNHUB_API_KEY=
COINGECKO_API_KEY=

# Facultatif : voix d'Eagle (ElevenLabs Agents). Création de l'agent : python -m tools.creer_agent_elevenlabs
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
